# Copy to .env and fill in. Never commit .env.

# LLM for the agent loop: any OpenAI-compatible endpoint (default: OpenRouter free tier).
# List free models with tool calling: uv run detectforge llm models
OPENROUTER_API_KEY=
DETECTFORGE_LLM_BASE_URL=https://openrouter.ai/api/v1
DETECTFORGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
DETECTFORGE_FALLBACK_MODEL=google/gemma-4-31b-it:free
# Local instead (Ollama): base URL http://localhost:11434/v1, any non-empty key, e.g. model qwen3:8b

# Per-rule budgets
DETECTFORGE_MAX_ITERATIONS=5
DETECTFORGE_MAX_MODEL_CALLS=20
DETECTFORGE_MAX_TOKENS_PER_RULE=400000

# Tracing (Langfuse): leave the keys empty to disable. Free cloud tier or a self-hosted URL.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Data
DETECTFORGE_DATA_DIR=data
