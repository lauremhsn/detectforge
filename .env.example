# Copy to .env and fill in. Never commit .env.

# LLM provider (agent loop, week 2)
ANTHROPIC_API_KEY=
DETECTFORGE_MODEL=claude-sonnet-5-5
DETECTFORGE_FALLBACK_MODEL=claude-haiku-5-5

# Per-rule budgets
DETECTFORGE_MAX_ITERATIONS=5
DETECTFORGE_MAX_COST_USD_PER_RULE=1.0
DETECTFORGE_TOOL_TIMEOUT_S=30

# Tracing (self-hosted Langfuse, week 2)
DETECTFORGE_LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Data
DETECTFORGE_DATA_DIR=data
