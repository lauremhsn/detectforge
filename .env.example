# Copy to .env and fill in. Never commit .env.

# LLM for the agent loop: any OpenAI-compatible endpoint (default: OpenRouter free tier).
# List free models with tool calling: uv run detectforge llm models
OPENROUTER_API_KEY=
DETECTFORGE_LLM_BASE_URL=https://openrouter.ai/api/v1
DETECTFORGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
DETECTFORGE_FALLBACK_MODEL=google/gemma-4-31b-it:free
# Local instead (Ollama): base URL http://localhost:11434/v1, any non-empty key, e.g. model qwen3:8b

# Per-rule budgets
DETECTFORGE_MAX_ITERATIONS=5
DETECTFORGE_MAX_MODEL_CALLS=20
DETECTFORGE_MAX_TOKENS_PER_RULE=400000

# Tracing (Langfuse): leave the keys empty to disable. Free cloud tier or a self-hosted URL.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Data
DETECTFORGE_DATA_DIR=data

# UI: allow the "Ask the agent" button (keep false on any public deployment)
DETECTFORGE_UI_ALLOW_AGENT_RUNS=false

# Review: who may approve or reject in the Review tab, as name:key pairs separated by commas.
# Each key must be 16+ characters; make one with: uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave empty to switch approving off (e.g. on a public deployment).
DETECTFORGE_REVIEWER_KEYS=

# Free-model requests the provider allows per day: 50 on OpenRouter's free tier, 1000 once 10 credits
# were ever purchased (shown in Agent operations; `detectforge llm quota` tells you which applies).
DETECTFORGE_DAILY_REQUEST_LIMIT=50
# LLM requests per run when writing a new rule (hardening uses DETECTFORGE_MAX_MODEL_CALLS)
DETECTFORGE_WRITE_MAX_MODEL_CALLS=15
