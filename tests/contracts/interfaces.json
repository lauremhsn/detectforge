        },
        "parent_command_line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Command Line"
        },
        "parent_image": {
          "title": "Parent Image",
          "type": "string"
        },
        "split": {
          "enum": [
            "tune",
            "heldout"
          ],
          "title": "Split",
          "type": "string"
        },
        "technique": {
          "pattern": "^T\\d{4}(\\.\\d{3})?$",
          "title": "Technique",
          "type": "string"
        },
        "transform": {
          "enum": [
            "none",
            "insertion",
            "substitution",
            "omission",
            "reordering",
            "recoding"
