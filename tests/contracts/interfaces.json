    "detectforge.harness.run.run": "(rule_yaml: str, events: list[detectforge.schemas.Event]) -> detectforge.schemas.Scorecard",
    "detectforge.rules.validate.validate_rule": "(rule_yaml: str) -> detectforge.schemas.ValidationResult"
