    "Event": {
      "additionalProperties": false,
      "description": "One Sysmon Event ID 1 (process creation) record, stored as one JSON line.",
      "properties": {
        "base_id": {
          "description": "Event this was mutated from; itself if unmutated.",
          "minLength": 1,
          "title": "Base Id",
          "type": "string"
